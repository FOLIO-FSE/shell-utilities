#!/usr/bin/bash
if [[ -z $okapi_url ]] && [[ ! -f okapi.url ]];then
        echo -n "Okapi URL: "
        read -r okapi_url
        echo -n "$okapi_url" > okapi.url
else
        okapi_url=$(cat okapi.url)
fi


if [[ -z $tenant ]] && [[ ! -f tenant ]];then
        echo -n "tenant: "
        read -r tenant
        echo -n "$tenant" > tenant
else
        tenant=$(cat tenant)
fi

if [[ -z $auth_tenant ]] && [[ ! -f auth.tenant ]];then
        echo -n "Auth tenant: "
        read -r auth_tenant
        echo -n "$auth_tenant" > auth.tenant
else
        tenant=$(cat tenant)
fi


if [[ ${auth_tenant} == "" ]];then auth_tenant=${tenant};fi

if [[ ! -f okapi-login.json ]];then

echo -n "Username: "
read -r username 
echo -n "Password: "
read -r pwd

IFS='' read -r -d '' okapi_login << EndOfAuth
{
  "tenant": "${tenant}",
  "username": "${username}",
  "password": "${pwd}"
}
EndOfAuth

echo "${okapi_login}" > okapi-login.json

else
        okapi_login=$(cat okapi-login.json)
fi

response=$(curl -c - -s -X POST \
  -H "Content-type: application/json" \
  -H "X-Okapi-Tenant: ${tenant}" \
  -d "${okapi_login}" \
  -w '\nCURL_HTTP_CODE:%{http_code}\n' \
  "${!libraryokapi}/authn/login-with-expiry")
curl_rc=$?

case $curl_rc in
  0) ;;
  6)  echo "Error: could not resolve host for ${!libraryokapi}" >&2; exit 1 ;;
  7)  echo "Error: could not connect to ${!libraryokapi} (connection refused / no route)" >&2; exit 1 ;;
  28) echo "Error: connection to ${!libraryokapi} timed out" >&2; exit 1 ;;
  35) echo "Error: SSL/TLS handshake failed with ${!libraryokapi}" >&2; exit 1 ;;
  *)  echo "Error: curl failed with exit code $curl_rc" >&2; exit 1 ;;
esac

http_code=$(grep CURL_HTTP_CODE: <<< "$response" | cut -d: -f2)
okapi_token=$(grep folioAccessToken <<< "$response" | cut -f7)

if [[ -z $okapi_token ]]; then
  echo "Error: login failed (HTTP ${http_code})" >&2
  exit 1
fi

echo -n ${okapi_token} >  okapi.token

#!/usr/bin/bash

nomsg="no"
reader="pv"
logpath="./"

while getopts "np:" opt; do
  case $opt in
    n)
      nomsg="yes"
			reader="cat"
      ;;
    p)
      logpath="$OPTARG"
      ;;
    \?)
      echo "Error: Invalid option -$OPTARG" >&2
      echo "Usage: $0 [-n]" >&2
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

logpath="${logpath%/}"

packages=(
	"pv"
	"dos2unix"
)

for package in "${packages[@]}";do
	which ${package} >/dev/null 2>&1 || (logmsg="Package ${package} not installed. Please install before continuing" && log_msg && missing=1)
done

[[ ${missing} -eq 1 ]] && exit

csvkitmissing=1
if command -v csvcut >/dev/null;then csvkitmissing=0;fi
if pip show csvkit >/dev/null 2>&1; then csvkitmissing=0;fi
if uv pip show csvkit >/dev/null 2>&1; then csvkitmissing=0;fi

[[ $csvkitmissing -eq 1 ]] && logmsg="Package csvkit not installed. Please install before continuing" && log_msg && exit

filelist=("$@")
infile="${filelist[0]}"

rm -f "${finalfile}" "${errorfile}"
rm -f filefix*_bad filefixa* 

if [[ ${filelist[-1]} == "us-single" ]]; then
	unset 'filelist[${#filelist[@]}-1]'
	dateformat="us-single"
fi
if [[ ${filelist[-1]} == "uk-single" ]]; then
	unset 'filelist[${#filelist[@]}-1]'
	dateformat="uk-single"
fi

if [[ -z ${infile} ]];then echo "You must supply a file name or expression (wildcards OK). Usage: filefix [filename]";fi

if [[ -z $1 ]];then
	echo "This tool converts csv data to tsv, performs basic cleaning, and does field frequency counts "
	echo "It detects date formats and converts MM-DD-YYYY and DD-MM-YYYY dates to YYYY-MM-DD. "
	echo 
	echo "Usage: filefix [filename]"
	echo "Options:"
	echo "-n no messages (suppress interactive output)"
	echo "-p path to log file"
	echo
	exit
else
	infile=${1}
fi

log_msg() {
	[[ ${nomsg} == "no" ]] && echo "${logmsg}" || echo "${logmsg}" >> "${logfile}"
}

fix_characters(){
	local file=${1}
	sed -i "
	s/['\"];['\"]/;/g
	s/[$SINGLE]/'/g
	s/[$DOUBLE]/\"/g
	s/[$NBSP]/ /g
	s/[$CONTROL]/ /g
	s/[‡\x87]\([a-zA-Z0-9]\) */\x1F\1/g
	s/\";\"/;/g
	s/^\"//
	s/\"$//
	s/^ +//
	s/ *\t */\t/g
	s/ +$//
	s/\b[(]*null[)]*\b//ig
	s/()//g
	s/\r/ /g
	s/\"\?\t\"\?/\t/g
	" ${file}
}

fix_dos(){
	local oldfile="${1}old"
	local fixedfile="${1}"
	cp ${fixedfile} ${oldfile}
	awk 'BEGIN{FS="\t";RS=ORS="\n"}{if ($numfields !~ /\r$/){print $0"\r"}else print $0}' ${oldfile} > "${fixedfile}"
	cp ${fixedfile} ${oldfile}

	# normalize out newlines within fields in dos files
	awk -v ORS=$'\x1d' -v RS="\r\n" '{gsub("\n", " ", $0); print $0}' "${oldfile}" |tr $'\x1d' "\n" > ${fixedfile} 
	rm ${oldfile}
}

function to_tsv(){
	local file="${1}"

	case $filetype in
		pipe)
			sed -i 's/|/\t/g' ${file} ;;
		carrot)
			sed -i 's/\^/\t/g' ${file} ;;
		comma)
			csvformat -T ${file} > "${file}1"
			mv "${file}1" ${file} ;;
		semicolon)
			sed -i 's/;/\t/g' ${file} ;;
	esac
}

function fix_file() {
local infile="${1}"
local finalfile="${2}"
local outfile="$(sed 's/\.....\?$//' <<< "${infile}")"
filedetect="${infile,,}"
filecontent=""

[[ "${filedetect}" =~ loan ]] && filecontent="loan"

if [[ "${infile: -4}" == "xlsx" ]];then
	[[ ${nomsg} == "no" ]] && echo "Excel file detected -- converting"
	excel2tsv "${infile}"

	if [[ $(head -1 "${outfile}.tsv") =~ ^$'\t' ]];then
		cut -f2- "${outfile}.tsv" > tmp
		mv tmp "${outfile}.tsv"
	fi
	
	infile="${outfile}.tsv"
	foundExcel=1
fi

logmsg="################ Processing ${infile} #####################"
log_msg

if [[ ! -f "${infile}" ]];then echo "The input file ${infile} could not be found";exit;fi

if head -c 10000 "${infile}" | grep -qP '\n';then
	logmsg="No newlines could be detected in the first 10,000 characters. Please verify file"
	log_msg	
	exit
fi
dosfile=0

[[ ${nomsg} == "no" ]] && echo "Correcting encoding"

encodingtype=$(file -i "${infile}" |sed 's/.*charset=//')
encodingtype=${encodingtype,,}

case ${encodingtype} in
	utf-16le)
		$reader "${infile}" | iconv -f utf-16le -t utf-8 -c > tmpfile;;
	latin1|iso-8859-1)
		$reader "${infile}" | iconv -f latin1 -t utf-8 -c > tmpfile;;
	iso-8859-15)
		$reader "${infile}" | iconv -f iso-8859-15 -t utf-8 -c > tmpfile;;
	*)	
		$reader "${infile}" | iconv -f utf-8 -t utf-8 -c > tmpfile;;
esac

head -1 tmpfile | grep -q $'\r' && dosfile=1

numrecs=$(wc -l tmpfile |cut -d " " -f1)
num_per_file=$(($numrecs / 5 + 1))

prefix="filefix$(date +%s)"
split -l $num_per_file tmpfile ${prefix}
splitlist=(${prefix}aa ${prefix}ab ${prefix}ac ${prefix}ad ${prefix}ae)
rm -f tmpfile

firstline="$(head -1 ${prefix}aa)"

echo "${firstline}" | grep -q "|" && filetype="pipe"
echo "${firstline}" | fgrep -q "^" && filetype="carrot"
echo "${firstline}" | grep -q "," && filetype="comma"
echo "${firstline}" | grep -qP "\t" && filetype="tab"
echo "${firstline}" | grep -qP ";" && filetype="semicolon"

if [[ ! $filetype ]];then
	logmsg="${infile} doesn't appear to be comma or tab delimited.
Please supply a different file or correct the first line.
"
	log_msg
	exit
fi

[[ ${nomsg} == "no" ]] && echo "Normalizing format"

for splitfile in ${splitlist[@]};do 
	to_tsv ${splitfile} &
done
wait

head -1000 ${prefix}aa | awk -F'\t' '{ for(i=1;i<=NF;i++){ if($i ~ /^[[:space:]]+/ || $i ~ /[[:space:]]+$/){ print "detected";exit 1 } } }' |grep -q detected && leading_trail="yes"
[[ ${leading_trail} == "yes" ]] && logmsg="Leading/trailing spaces detected" && log_msg

if [[ $dosfile -eq 1 ]];then
	for splitfile in ${splitlist[@]};do 
		fix_dos ${splitfile} &
	done
	wait
fi

# detect file characteristics. First line is assumed to contain either tabs or commas

numrecs=$(wc -l "${infile}" |cut -d " " -f1)
numfields=$(awk 'BEGIN{FS="\t"}{print NF;exit}' ${prefix}aa)
num_labeled_fields=$(head -1 filefixaa |tr '\t' '\n' |grep -i [a-z0-9] |wc -l)

logmsg="The following $numfields fields in $numrecs lines were detected:
"
log_msg

logmsg="
$numfields fields detected but $num_labeled_fields fields with labels were detected.

WARNING: DISPARITY BETWEEN NUMBER OF FIELDS AND NUMBER OF LABELS USUALLY INDICATES DATA PROBLEMS -- INSPECT FILE.

"

[[ $numfields != $num_labeled_fields ]] && log_msg

logmsg=""

head -50 ${prefix}aa |grep -o "\b[1-9]\.[0-9]\+E+[0-9]\+\b" > /dev/null && logmsg="WARNING: POSSIBLE EXCEL CORRUPTION -- INSPECT FILE"

[[ -n "$logmsg" ]] && log_msg

# normalize fieldnames in file
if [[ ${filecontent} == "loan" ]];then
sed -i '
1 s/ //g
1 s/[^0-9A-Za-z_#)(\.\t\-]//g
1 s/\b[up][^\t]*barcode\b/patron_barcode/i
1 s/\bpatronno[^\t]*\b/patron_barcode/i
1 s/\bbarcode[^\t]*p[^\t]*\b/patron_barcode/i
1 s/\bi[^\t]*barcode\b/item_barcode/i
1 s/\bbarcode[^\t]*i[^\t]*\b/item_barcode/i
1 s/\bout[^\t]*date\b/out_date/i
1 s/\bcharge[^\t]*date\b/out_date/i
1 s/\bcharge[^\t]*loc[^\t]*\b/service_point_id/i
1 s/\bcheckedout\b/out_date/i
1 s/\bcheckoutdate\b/out_date/i
1 s/\bdatecheck.?.?out\b/out_date/i
1 s/\bdatecheckout\b/out_date/i
1 s/\bloandate\b/out_date/i
1 s/\bdue[^\t]*date\b/due_date/i
1 s/\bcurrent[^\t]*due[^\t]*date\b/due_date/i
1 s/\bdate[^\t]*due\b/due_date/i
1 s/\btot[^\t]*renew[^\t]*\b/renewal_count/i
1 s/\brenew[^\t]*\b/renewal_count/i
1 s/\b[^\tp]*tatus\b/next_item_status/i
1 s/\b[^p\t][^\t]*arcode/item_barcode/i
s/ [0-9]*:[0-9]*\($\|[\t]\)/\1/g
' ${prefix}aa 

logmsg="Loan file detected. Attempting to standardize headers" && log_msg

else
	sed -i '1 s/[^0-9A-Za-z_#=\)\(\.\t\-]//g;s/=[^\t]*//g' ${prefix}aa
fi

read -r fieldnames < ${prefix}aa

fieldnames=$(tr -dc "[[A-Za-z0-9]]_	\-#." <<< "${fieldnames}")

logmsg=$(
	echo "The following fields were detected in ${infile}"
	echo "${fieldnames}" |tr "\t" "\n" |grep -n . |column 
	echo
	echo "The following date containing fields were detected in ${infile}"
	echo "${fieldnames}" |tr "\t" "\n" |grep -ni "[^p]date" |sed '/[Yy][Ee][Aa][Rr]\|[Mm][Oo][Nn][Tt][Hh]\|[Dd][Aa][Yy]\|[Nn][Oo][Tt][Ee]/d'
	echo
	echo "${fieldnames}" |tr "\t" "\n" |grep -ni "[^p]date\|^date\|^fecha\|nacimiento$" |sed '/[Yy][Ee][Aa][Rr]\|[Mm][Oo][Nn][Tt][Hh]\|[Dd][Aa][Yy]\|[Nn][Oo][Tt][Ee]/d'
)

log_msg
logmsg=""

datefields=$(echo "${fieldnames}" |tr "\t" "\n" |grep -ni date |tr [A-Z] [a-z] | sed '/year\|month\|day\|note/d; s/:.*//' |tr '\n' ' ')
cutfields=$(echo "${datefields// /,}" | sed 's/^/-f/;s/,$//' |grep [0-9])

if [[ ${#cutfields} -gt 0 ]];then
	head -50 ${prefix}aa > tmp${prefix}_datecheck1
	cut ${cutfields} tmp${prefix}_datecheck1 > tmp${prefix}_datecheck 
	sed -i 's/,//g' tmp${prefix}_datecheck
	 
	words=0
	
	cat tmp${prefix}_datecheck |grep -Pqoi "\b(apr|aug|dec|feb|jan|jul|jun|mar|may|nov|oct|sep)[^\t\/-]*[\/-][0-9][0-9]*[\/-][0-9][0-9]*\b" && words=1
	cat tmp${prefix}_datecheck |grep -Pqoi "\b[0-9\[0-9]*[\/-](apr|aug|dec|feb|jan|jul|jun|mar|may|nov|oct|sep)[^\t\/-]*[\/-][0-9][0-9]*\b" && words=2

	cat tmp${prefix}_datecheck |grep -Pqoi "\b(apr|aug|dec|feb|jan|jul|jun|mar|may|nov|oct|sep)[^\t]* [0-9][0-9]* [0-9][0-9]*\b" && words=3
	cat tmp${prefix}_datecheck |grep -Pqoi "[0-9\[0-9]* (apr|aug|dec|feb|jan|jul|jun|mar|may|nov|oct|sep)[^\t]* [0-9][0-9]*\b" && words=4
	
	if [[ $words -gt 0 ]] && [[ ${nomsg} == "no" ]];then
		logmsg="	
Dates containing words detected
"
		log_msg
	fi
	
	if [[ -z $dateformat ]]; then
		cat tmp${prefix}_datecheck |grep -o "\b[0|1]\?[0-9][/\-][0-3]\?[0-9][/\-][27-9][0-9]\b" > /dev/null && echo "Six digit date with trailing year detected." && dateformat="us-single"
		cat tmp${prefix}_datecheck |grep -o "\b[0-3]\?[0-9][/\-][0|1]\?[0-9][/\-][27-9][0-9]\b" > /dev/null && echo "Six digit UK date with trailing year detected." && dateformat="6digit-trailing-uk"
		cat tmp${prefix}_datecheck |grep -o "\b[78-9][0-9][/\-][0|1]\?[0-9][/\-][0-3]\?[0-9]\b" > /dev/null && echo "Six digit date with leading year detected." && dateformat="6digit-leading"
	
		cat tmp${prefix}_datecheck |grep -o "\b[0-2][0-9][/\-][0-9][0-9][/\-][12][09][0-9][0-9]\b" > /dev/null &&  dateformat="us"
		cat tmp${prefix}_datecheck |grep -o "\b[0-9][/\-][23][0-9][/\-][12][09][0-9][0-9]\b" > /dev/null &&  dateformat="us-single"
		cat tmp${prefix}_datecheck |grep -o "\b[23][0-9][/\-][0-9][0-9][/\-][12][09][0-9][0-9]\b" > /dev/null && dateformat="uk"
		cat tmp${prefix}_datecheck |grep -o "\b[23][0-9][/\-][0-9][/\-][12][09][0-9][0-9]\b" > /dev/null && dateformat="uk-single"
		cat tmp${prefix}_datecheck |grep -o "\b[12][01239][0-9][0-9]\/[0-9][0-9]\/[0-9][0-9]\b" > /dev/null && dateformat="slashes"
		cat tmp${prefix}_datecheck |grep -o "\b[12][01239][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*\b" > /dev/null && dateformat="numbers"
	fi

	if [[ $words -gt 0 ]];then	
		[[ ${dateformat} == "uk" ]] && logmsg="UK dates detected. DD-MM-YYYY dates will be converted to YYYY-MM-DD"
		[[ ${dateformat} == "uk-single" ]] && logmsg="UK dates with single digits detected. D-M-YYYY dates will be converted to YYYY-MM-DD"
		[[ ${dateformat} == "us" ]] && logmsg="US dates detected. MM-DD-YYYY dates will be converted to YYYY-MM-DD"
		[[ ${dateformat} == "us-single" ]] && logmsg="US dates with single digits detected. M-D-YYYY dates will be converted to YYYY-MM-DD"
		[[ ${dateformat} == "numbers" ]] && logmsg="Numeric string detected -- will be converted to YYYY-MM-DD"
		log_msg
	fi

	rm tmp${prefix}_datecheck
	rm tmp${prefix}_datecheck1
fi

SINGLE=$(echo -ne '\u00B4\u2018\u2019')
DOUBLE=$(echo -ne '\u201C\u201D')
NBSP=$(echo -ne '\uc2a0\u00a0\ufeff')
CONTROL=$(echo -ne '\u001b\u0007\u0001')

[[ ${nomsg} == "no" ]] && echo -en "Analyzing ${infile}. Please be patient"

while [ true ];do
	[[ ${nomsg} == "no" ]] && echo -en "."
	sleep 1
done & 
background_pid=$!

for file in ${splitlist[@]};do 
	fix_characters ${file} & 
	pids[${file}]=$!
done

for pid in ${pids[*]}; do
    wait $pid
done

disown $background_pid
kill $background_pid 

case $dateformat in
	us)
		logmsg="No UK formatted dates detected in first 50 lines"
		logmsg="Converting MM-DD-YYYY dates to YYYY-MM-DD and stripping blank dates"
		;;
	us-single)
		logmsg="Converting US dates with single digits to to YYYY-MM-DD and stripping blank dates"
		;;

	uk)
		logmsg="Converting DD-MM-YYYY dates to YYYY-MM-DD and stripping blank dates"
		;;
	uk-single)
		logmsg="Converting UK dates with single digits to YYYY-MM-DD and stripping blank dates"
		;;
	slashes)
		logmsg="Reformatting dates to YYYY-MM-DD"
		;;
	numbers)
		logmsg="Reformatting numeric dates to YYYY-MM-DD"
		;;
esac

log_msg

if [[ $words -gt 2 ]];then dateformat="us-single";fi

read -r -d '' awkscript << "ENDOFAWK"
#!/usr/bin/awk -f

BEGIN {
	FS=OFS="\t"
	goodrecs=badrecs=0
	current0=last0=""
	split(DATEFIELDS, datefields, " ")
}

function fix_dates() {
	for (datefield in datefields) {
		fixdate = datefields[datefield]

		# slashes to hyphens
		gsub(/\//, "-", $fixdate)
		# remove timestamps
		if (DATEFORMAT == "numbers" && NR > 1) { $fixdate = substr($fixdate,1,4)"-"substr($fixdate,5,2)"-"substr($fixdate,7,2) }

		if (WORDS == 3){split($fixdate, tempdate, " ");$fixdate = tempdate[1]"-"tempdate[2]"-"tempdate[3];gsub(/,/, "", $fixdate)}
		if (WORDS == 4){split($fixdate, tempdate, " ");$fixdate = tempdate[2]"-"tempdate[1]"-"tempdate[3];gsub(/,/, "", $fixdate)}

		sub(/ [0-9\.:]*$/, "", $fixdate)

		arraylen = split($fixdate, splitdate,"-")

		if (arraylen == 3) {
			if (WORDS > 0) {
				splitdate[1] = tolower(splitdate[1])
				splitdate[2] = tolower(splitdate[2])

				if (splitdate[1] ~ /[a-z]/) {
					DATEFORMAT = "us-single"
					gsub(/^jan.*/, "01", splitdate[1])
					gsub(/^feb.*/, "02", splitdate[1])
					gsub(/^mar.*/, "03", splitdate[1])
					gsub(/^apr.*/, "04", splitdate[1])
					gsub(/^may.*/, "05", splitdate[1])
					gsub(/^jun.*/, "06", splitdate[1])
					gsub(/^jul.*/, "07", splitdate[1])
					gsub(/^aug.*/, "08", splitdate[1])
					gsub(/^sep.*/, "09", splitdate[1])
					gsub(/^oct.*/, "10", splitdate[1])
					gsub(/^nov.*/, "11", splitdate[1])
					gsub(/^dec.*/, "12", splitdate[1])
				}
				if (splitdate[2] ~ /[a-z]/) {
					DATEFORMAT = "uk-single"
					gsub(/^jan.*/, "01", splitdate[2])
					gsub(/^feb.*/, "02", splitdate[2])
					gsub(/^mar.*/, "03", splitdate[2])
					gsub(/^apr.*/, "04", splitdate[2])
					gsub(/^may.*/, "05", splitdate[2])
					gsub(/^jun.*/, "06", splitdate[2])
					gsub(/^jul.*/, "07", splitdate[2])
					gsub(/^aug.*/, "08", splitdate[2])
					gsub(/^sep.*/, "09", splitdate[2])
					gsub(/^oct.*/, "10", splitdate[2])
					gsub(/^nov.*/, "11", splitdate[2])
					gsub(/^dec.*/, "12", splitdate[2])
				}
			}

			if (DATEFORMAT == "uk") { $fixdate = splitdate[3]"-"splitdate[2]"-"splitdate[1] }
			if (DATEFORMAT == "uk-single") { 
				if (length(splitdate[3]) == 2) {
					if (splitdate[3] < 30) { splitdate[3] = "20"splitdate[3] } else { splitdate[3] = "19"splitdate[3] }
					}
				$fixdate = sprintf("%04d-%02d-%02d", splitdate[3], splitdate[2], splitdate[1]) 
			}

			if (DATEFORMAT == "us") { $fixdate = splitdate[3]"-"splitdate[1]"-"splitdate[2] }
			if (DATEFORMAT == "us-single") { 
				if (length(splitdate[3]) == 2) {
					if (splitdate[3] < 30) { splitdate[3] = "20"splitdate[3] } else { splitdate[3] = "19"splitdate[3] }
				}
				$fixdate = sprintf("%04d-%02d-%02d", splitdate[3], splitdate[1], splitdate[2]) 
			}

			if (DATEFORMAT == "6digit-leading") { 
				if (splitdate[1] < 30) { splitdate[1] = "20"splitdate[1] } else { splitdate[1] = "19"splitdate[1] }
				$fixdate = sprintf("%04d-%02d-%02d", splitdate[1], splitdate[2], splitdate[3]) 
			}
			if (DATEFORMAT == "6digit-trailing-uk") { 
				if (splitdate[3] < 30) { splitdate[3] = "20"splitdate[3] } else { splitdate[3] = "19"splitdate[3] }
				$fixdate = sprintf("%04d-%02d-%02d", splitdate[3], splitdate[2], splitdate[1]) 
			}

			# fix some 2 digit year issues
			if ($fixdate ~ /^[4-9][0-9]-/){ $fixdate = "19"$fixdate }
			# find zero value dates
			if ($fixdate ~ /-00/) { $fixdate = "" }
			if ($fixdate ~ /^[\- ]*$/) { $fixdate = "" }
			
		} else {
			if (NR != 1 || FILENAME != PREFIX"aa") { $fixdate = "" }
		}
	}
if ($fixdate == ""){print "blanked date" > "bad_dates"}
}

{
	if (NF == numfields) { 
		if (NR != 1 || FILENAME != PREFIX"aa"){ fix_dates() }
		print $0 > outfile	
	} else {
		if ((NF == numfields + 1) && (substr($0, length($0), 1) == "\t")) {
			$0 = substr($0, 1, length($0) - 1)
			fix_dates()
			print $0 > outfile	
		} else {
			badrecs++
			print $0 > badfile
		}
	}
	if (NR % 2000 == 0 && NOMSG == "no" && FILENAME == "filefixad") {printf "Records processed: %s\r", NR*5}
}
ENDOFAWK

echo -e "${awkscript}" > tmp${prefix}_filefixawk
chmod 700 tmp${prefix}_filefixawk

[[ ${nomsg} == "no" ]] && echo "Performing corrections"

for splitfile in ${splitlist[@]};do 
	awk -v numfields=$numfields -v outfile="${splitfile}_out" -v badfile="${splitfile}_bad" -v DATEFORMAT="${dateformat}" -v WORDS="${words}" -v DATEFIELDS="${datefields}" -v PREFIX=${prefix} -v NOMSG=${nomsg} -f tmp${prefix}_filefixawk ${splitfile} &
done
wait

cat ${prefix}a*_out >> "${finalfile}"
cat ${prefix}a*_bad > "${errorfile}" 2>/dev/null

rm -f ${prefix}* 
rm tmp${prefix}_filefixawk

numclean=$(wc -l "${finalfile}" |cut -d " " -f1)

if [[ -f bad_dates ]];then
	logmsg="Blank dates have been identified. Examining date fields for anomalies recommended" && log_msg
	rm bad_dates
fi

logmsg="$numclean records have been output to ${finalfile}"
log_msg

if [[ -f ${errorfile} ]];then
	numbad=$(wc -l "${errorfile}" |cut -d " " -f1)
	logmsg="$numbad bad records were output to ${errorfile}" && log_msg
fi

if [[ foundExcel -eq 1 ]];then
	rm -f "${infile}"
fi
foundExcel=0
}

for file in "${filelist[@]}";do
	if [[ $(head -n 1 "${file}") =~ ^[[:space:]]*$ ]]; then
		logmsg="First line contains only whitespace, deleting all leading blank lines" && log_msg
		sed -i '1,/^[[:alnum:]]/ { /^[[:space:]]*$/d }' "${file}"
	fi

	if [[ "${file}" =~ \....$ ]];then
		finalfile=$(echo "${file}" |sed 's/\(.*\)\(\....$\)/\1_fixed.tsv/')
		logfile=$(echo "${file}" |sed 's/\(.*\)\(\....$\)/\1.log/')
	else
		finalfile="${file}_fixed.tsv"
		logfile="${file}.log"
	fi
	logfile="${logpath}/filefix_${logfile}"

	errorfile="${file}_error"
	rm -f "${finalfile}" "${logfile}"

	fix_file "${file}" "${finalfile}"
done


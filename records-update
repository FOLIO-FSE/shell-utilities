counter=0
SECONDS=1

while mapfile -t -n ${readsize} lines && ((${#lines[@]})); do

        if [[ $SECONDS -gt 500 ]]; then
                auth 2>/dev/null || authn 2>/dev/null
		okapi_token=$(cat okapi.token)
                SECONDS=1
		OFFSET=$(($OFFSET + 1))
        fi

	TIMER=$(($OFFSET * 500 + $SECONDS))

	if [[ -n ${syncendpoint} ]];then
		syncbatch $(($counter + 1)) "${lines[@]}"
		counter=$(($counter + ${#lines[@]}))
	else
		seq=0
		for ((start=0; start<${#lines[@]}; start+=recsperconn));do
			group=("${lines[@]:start:recsperconn}")
			
			fixrecord "${seq}" "${group[@]}" &

			counter=$(($counter + ${#group[@]}))
			seq=$(($seq + 1))
		done
		wait
	fi
	
        TIME=$TIMER;msg="$SECONDS seconds"
        if [[ $TIMER -gt 60 ]];then TIME=$(bc <<< "scale=1;$TIMER/60");msg="$TIME minutes";fi
        if [[ $TIMER -gt 3600 ]];then TIME=$(bc <<< "scale=1;$TIMER/3600");msg="$TIME hours     ";fi

        echo -en "Processing record $counter of $numrecs in $msg\r"

	cat tmp_records.${baserecordtype}* >> ${outfile}
	rm tmp_records.${baserecordtype}*

done < ${infile}


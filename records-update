fixrecord() {
	local seq=${1}
	shift
	local line
	local uuid
	local value
	local uuids=()
	local values=()
	local updated_record
	local apicall
	local getargs=()
	local putargs=()
	local i

	for line in "$@";do
		IFS=$'\t' read -r uuid value <<< "${line}"
		uuids+=("${uuid}")
		values+=("${value}")
	done

	# retrieve all records in the group over one connection, each into its own file
	for ((i=0; i<${#uuids[@]}; i++));do
		if [[ ${#getargs[@]} -gt 0 ]];then getargs+=(--next);fi

		if [[ ${recordtype} == "source-storage/records" ]];then 
			getargs+=(-s -X GET -H "Accept: application/json" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" -o "tmp_get.${baserecordtype}.${seq}.${i}" "${okapi_url}/source-storage/records/${uuids[i]}/formatted?idType=INSTANCE")
		else
			getargs+=(-s -X GET -H "Accept: application/json" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" -o "tmp_get.${baserecordtype}.${seq}.${i}" "${okapi_url}/${recordtype}/${uuids[i]}") # get target record

			if [[ ${copyvalue} == "yes" ]];then 
				getargs+=(--next -s -X GET -H "Accept: application/json" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" -o "tmp_src.${baserecordtype}.${seq}.${i}" "${okapi_url}/${recordtype}/${values[i]}") # get source record
			fi
		fi
	done

	curl "${getargs[@]}"

	for ((i=0; i<${#uuids[@]}; i++));do
	uuid=${uuids[i]}
	value=${values[i]}

	if [[ ${recordtype} == "source-storage/records" ]];then 
		apicall=$(jq . < "tmp_get.${baserecordtype}.${seq}.${i}" 2>/dev/null)
		uuid=$(echo ${apicall} |jq -r .id)
		
	else
		apicall=$(cat "tmp_get.${baserecordtype}.${seq}.${i}" 2>/dev/null)

		if [[ ${copyvalue} == "yes" ]];then 
			value=$(jq -r .permanentLocationId < "tmp_src.${baserecordtype}.${seq}.${i}" 2>/dev/null) # extract value from source record
		fi
	fi
	
	updated_record=$(echo "${apicall}"  |jq -r --arg VALUE "${value}" "${jq_expr}")
#jq . <<< ${updated_record}
#exit
		#updated_record=${apicall//$pattern/$replace}
		printf '%s' "${updated_record}" > "tmp_put.${baserecordtype}.${seq}.${i}"

		if [[ ${#putargs[@]} -gt 0 ]];then putargs+=(--next);fi
		putargs+=(--http1.1 -s -w '\n' -X PUT -H "Content-type: application/json" -H "Accept: text/plain" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" --data-binary "@tmp_put.${baserecordtype}.${seq}.${i}" "${okapi_url}/${recordtype}/${uuid}")
	done

	# send all updated records in the group over one connection
	curl "${putargs[@]}" |grep -i [a-z] >> "tmp_records.${baserecordtype}.${seq}"

	rm -f tmp_get.${baserecordtype}.${seq}.* tmp_src.${baserecordtype}.${seq}.* tmp_put.${baserecordtype}.${seq}.*
}

# retrieves records by id in chunks of 50 over one connection
# each response is saved to ${prefix}.<n>; returns failure if any request did not return 200
syncfetch() {
	local prefix=${1}
	shift
	local ids=("$@")
	local getargs=()
	local idstring
	local codes
	local start
	local n=0

	if [[ ${#ids[@]} -eq 0 ]];then return 0;fi

	for ((start=0; start<${#ids[@]}; start+=50));do
		idstring="${ids[@]:start:50}"
		if [[ ${#getargs[@]} -gt 0 ]];then getargs+=(--next);fi
		getargs+=(-s -w '%{http_code}\n' -X GET -H "Accept: application/json" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" -o "${prefix}.${n}" "${okapi_url}/${recordtype}?limit=50&query=id==(${idstring// /%20or%20})")
		n=$(($n + 1))
	done

	codes=$(curl "${getargs[@]}")
	! grep -qv '^200$' <<< "${codes}"
}

# updates one batch of records through the batch-sync endpoint
syncbatch() {
	local firstrec=${1}
	shift
	local line
	local uuid
	local value
	local ids=()
	local srcids=()
	local httpcode
	local logfile="tmp_records.${baserecordtype}.0"
	local batchlabel="Records ${firstrec}-$((${firstrec} + $# - 1))"
	local prog

	rm -f tmp_sync.*
	: >> "${logfile}"

	for line in "$@";do
		IFS=$'\t' read -r uuid value <<< "${line}"
		if [[ -z ${uuid} ]];then continue;fi
		ids+=("${uuid}")
		srcids+=("${value}")
		printf '%s\t%s\n' "${uuid}" "${value}" >> tmp_sync.values.tsv
	done

	if [[ ${#ids[@]} -eq 0 ]];then return;fi

	jq -Rn '[inputs | split("\t") | {(.[0]): (.[1:] | join("\t"))}] | add // {}' tmp_sync.values.tsv > tmp_sync.values.json

	if ! syncfetch tmp_sync.get "${ids[@]}";then
		echo "${batchlabel} failed: could not retrieve records" >> "${logfile}"
		printf '%s\n' "$@" >> "${failfile}"
		return
	fi
	cat tmp_sync.get.* | jq -n --arg LABEL "${synclabel}" '[inputs | .[$LABEL][]]' > tmp_sync.recs.json

	if [[ ${copyvalue} == "yes" ]];then
		if ! syncfetch tmp_sync.src $(printf '%s\n' "${srcids[@]}" |sort -u);then
			echo "${batchlabel} failed: could not retrieve source records" >> "${logfile}"
			printf '%s\n' "$@" >> "${failfile}"
			return
		fi
		cat tmp_sync.src.* 2>/dev/null | jq -n --arg LABEL "${synclabel}" '[inputs | .[$LABEL][] | {(.id): (.permanentLocationId // "null")}] | add // {}' > tmp_sync.srcmap.json
		jq --slurpfile m tmp_sync.srcmap.json 'map_values($m[0][.] // "")' tmp_sync.values.json > tmp_sync.values.tmp && mv tmp_sync.values.tmp tmp_sync.values.json
	fi

	jq -rn --slurpfile v tmp_sync.values.json --slurpfile r tmp_sync.recs.json '($v[0] | keys) - ($r[0] | map(.id)) | .[]' < /dev/null | while read -r uuid;do
		echo "Record not found: ${uuid}" >> "${logfile}"
	done

	prog='{($LABEL): [$syncrecs[0][] | $syncvals[0][.id] as $VALUE | ('$'\n'"${jq_expr}"$'\n'') | del(.metadata) | del(.holdingsItems) | del(.bareHoldingsItems)]}'

	if ! jq -cn --arg LABEL "${synclabel}" --slurpfile syncvals tmp_sync.values.json --slurpfile syncrecs tmp_sync.recs.json "${prog}" < /dev/null > tmp_sync.batch.json;then
		echo "${batchlabel} failed: jq expression error" >> "${logfile}"
		printf '%s\n' "$@" >> "${failfile}"
		return
	fi

	httpcode=$(curl --http1.1 -s -o tmp_sync.response -w '%{http_code}' -X POST -H "Content-type: application/json" -H "Accept: text/plain" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" --data-binary @tmp_sync.batch.json "${okapi_url}/${syncendpoint}")

	if [[ ${httpcode} != 2* ]];then
		echo "${batchlabel} failed (HTTP ${httpcode}): $(tr -d '\n' < tmp_sync.response 2>/dev/null)" >> "${logfile}"
		printf '%s\n' "$@" >> "${failfile}"
	fi

	rm -f tmp_sync.*
}



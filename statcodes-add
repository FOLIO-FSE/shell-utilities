#!/usr/bin/bash
auth 2>/dev/null || authn 2>/dev/null
tenant=$(cat tenant)
okapi_url=$(cat okapi.url)
okapi_token=$(cat okapi.token)


declare -A statcodetype_dict

defaultStatisticalCodeType='First summary'
defaultStatisticalCodeType=$(tr -dc [a-z0-9] <<< "${defaultStatisticalCodeType,,}")

eval "$(curl -s -w '\n' -X GET -H "Accept: application/json" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" "${okapi_url}/statistical-code-types?limit=100" |jq -r '.statisticalCodeTypes[] | @sh "statcodetype_dict[\(.name|tostring|ascii_downcase |gsub("[^0-9a-z]"; ""))]=\(.id|tostring)"')"

statisticalCodeTypeId="${statcodetype_dict[${defaultStatisticalCodeType}]}"

while IFS=$'\t' read -r code name;do

id=$(uuidgen)

IFS='' read -r -d '' statcode << EndOfStatCode

{
"id": "${id}",
"source": "local",
"statisticalCodeTypeId":"${statisticalCodeTypeId}",
"code":"${code}",
"name":"${name}"
}
EndOfStatCode


curl --http1.1 -s -w '\n' -X POST -H "Content-type: application/json" -H "X-Okapi-Tenant: ${tenant}" -H "x-okapi-token: ${okapi_token}" -d "${statcode}" "${okapi_url}/statistical-codes"

done < statcodes.tsv


